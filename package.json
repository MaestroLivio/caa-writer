{
  "name": "caa-writer",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "description": "Word processor CAA offline con motore semantico locale",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:frontend": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc src/lib/editor/selection.ts src/lib/workspace/layout.ts src/lib/association/scope.ts src/lib/editor/sentence.ts src/lib/freeboard.ts src/lib/content-filter.ts --rootDir src/lib --outDir .test-build --module esnext --target es2022 --moduleResolution bundler --skipLibCheck && node --test tests/frontend",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:mac-arm": "tauri build --target aarch64-apple-darwin",
    "tauri:build:mac-intel": "tauri build --target x86_64-apple-darwin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide": "^1.69.0",
    "prosemirror-commands": "^1.6.0",
    "prosemirror-history": "^1.4.0",
    "prosemirror-keymap": "^1.2.0",
    "prosemirror-model": "^1.23.0",
    "prosemirror-schema-basic": "^1.2.0",
    "prosemirror-schema-list": "^1.4.0",
    "prosemirror-state": "^1.4.0",
    "prosemirror-tables": "^1.5.0",
    "prosemirror-view": "^1.34.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
