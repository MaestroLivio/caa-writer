{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi minimi: dialoghi di apertura/salvataggio, nient'altro.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen"
  ]
}
