{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAA Writer",
  "version": "0.15.16",
  "identifier": "org.caawriter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CAA Writer",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "copyright": "© 2026 CAA Writer contributors — CC BY-NC-SA 4.0",
    "shortDescription": "Word processor CAA offline",
    "longDescription": "CAA Writer è un videoscrittore con simbolizzazione CAA assistita, motore semantico locale e Visual Resource Studio. Funziona offline, senza GPU dedicata e su computer con 4 GB di RAM.",
    "resources": [
      "../resources/image/*",
      "../resources/dictionaries/*",
      "../resources/symbol-packs/core/**/*",
      "../resources/templates/**/*",
      "../resources/boards/**/*",
      "../resources/library/manifest.json",
      "../resources/library/templates/**/*",
      "../resources/library/boards/**/*",
      "../resources/ai/runtime/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": [
          "it-IT",
          "en-US"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "caadoc"
        ],
        "name": "CAA Writer Document",
        "description": "Documento CAA Writer",
        "mimeType": "application/x-caadoc",
        "role": "Editor"
      },
      {
        "ext": [
          "caaplay"
        ],
        "name": "CAA Writer Player",
        "description": "Documento CAA Writer per il player",
        "mimeType": "application/x-caaplay",
        "role": "Viewer"
      }
    ]
  }
}
